# URL del Web App de Google Apps Script que recibe el formulario de contacto.
# Crea tu propio despliegue siguiendo GOOGLE_SHEETS_SETUP.md y pégalo aquí.
PUBLIC_FORM_ACTION=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# Dominio público (canonical, Open Graph y sitemap)
PUBLIC_SITE_URL=https://www.ironbikers.co/

# Páginas legales
PUBLIC_PRIVACY_URL=https://politica-de-privacidad.ironbikers.co
PUBLIC_DELETE_ACCOUNT_URL=https://politica-eliminar-cuenta.ironbikers.co
