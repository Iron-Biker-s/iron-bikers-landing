---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Página no encontrada — Iron Biker's"
  description="La ruta que buscas no existe. Vuelve a la carretera."
>
  <main class="not-found" id="contenido" tabindex="-1">
    <div class="not-found-inner">
      <span class="not-found-kicker">&middot; Saliste de la ruta</span>
      <h1 class="not-found-title">404</h1>
      <p class="not-found-text">
        Esta curva no existe en nuestro mapa. Regresa a la carretera principal.
      </p>
      <a class="btn btn-outline-gold" href="/">Volver al inicio</a>
    </div>
  </main>
</BaseLayout>

<style>
  .not-found {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 120px var(--gutter);
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .not-found::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at 50% 30%,
      rgba(225, 29, 46, 0.14),
      transparent 65%
    );
    pointer-events: none;
  }

  .not-found-inner {
    position: relative;
  }

  .not-found-kicker {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--primary);
    margin-bottom: 16px;
  }

  .not-found-title {
    font-size: clamp(5rem, 18vw, 10rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
    margin-bottom: 16px;
  }

  .not-found-text {
    color: var(--secondary);
    font-size: 17px;
    max-width: 420px;
    margin: 0 auto 40px;
  }
</style>
