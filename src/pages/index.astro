---
import BaseLayout from "../layouts/BaseLayout.astro";
import Splash from "../components/Splash.astro";
import Hero from "../components/Hero.astro";
import StatusBar from "../components/StatusBar.astro";
import About from "../components/About.astro";
import Benefits from "../components/Benefits.astro";
import Jersey from "../components/Jersey.astro";
import Leaders from "../components/Leaders.astro";
import Events from "../components/Events.astro";
import Testimonials from "../components/Testimonials.astro";
import Alliances from "../components/Alliances.astro";
import News from "../components/News.astro";
import GalleryPreview from "../components/GalleryPreview.astro";
import Contact from "../components/Contact.astro";
import { getEntry } from "astro:content";
import { getCover } from "../lib/image";

const { data: hero } = (await getEntry("hero", "hero"))!;
const heroBg = await getCover(hero.bgImage, [768, 1280, 1920, 2560]);
---

<BaseLayout
  preloadImage={heroBg.src}
  preloadSrcset={heroBg.srcSet.attribute}
  preloadSizes="100vw"
>
  <Splash />
  <Hero bg={heroBg} />
  <StatusBar />
  <main id="contenido" tabindex="-1">
    <About />
    <Benefits />
    <Jersey />
    <Leaders />
    <Events />
    <GalleryPreview />
    <Testimonials />
    <Alliances />
    <News />
    <Contact />
  </main>
</BaseLayout>
