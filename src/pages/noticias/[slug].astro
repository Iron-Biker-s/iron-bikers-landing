---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, getEntry, render } from "astro:content";
import { getCover } from "../../lib/image";
import { formatDate } from "../../lib/date";
import { site } from "../../data/site";
import "../../styles/news.css";

export async function getStaticPaths() {
  const noticias = await getCollection("news");
  return noticias.map((nota) => ({
    params: { slug: nota.id },
    props: { nota },
  }));
}

const { nota } = Astro.props;
const { Content } = await render(nota);
const { title, date, author, summary, tags, cover } = nota.data;
const { data: siteInfo } = (await getEntry("site", "site"))!;

const coverImg = await getCover(cover, [720, 1080]);
const coverUrl = `${site.url}${cover}`;
const canonical = new URL(Astro.url.pathname, site.url).href;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  headline: title,
  description: summary,
  datePublished: date.toISOString(),
  image: coverUrl,
  author: { "@type": "Person", name: author },
  publisher: { "@type": "Organization", name: siteInfo.siteName },
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Inicio", item: `${site.url}/` },
    {
      "@type": "ListItem",
      position: 2,
      name: "Noticias",
      item: `${site.url}/noticias`,
    },
    { "@type": "ListItem", position: 3, name: title, item: canonical },
  ],
};
---

<BaseLayout
  title={`${title} — Iron Biker's`}
  description={summary}
  ogType="article"
  ogImage={cover}
  publishedTime={date.toISOString()}
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(articleSchema)}
    is:inline
  />
  <script
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbSchema)}
    is:inline
  />
  <main class="news-page" id="contenido" tabindex="-1">
    <article class="news-article">
      <a class="news-back" href="/noticias">&larr; Volver a noticias</a>

      <header class="news-article-header">
        <div class="news-article-meta">
          <time datetime={date.toISOString()}>{formatDate(date)}</time>
          <span>&middot;</span>
          <span>{author}</span>
        </div>
        <h1 class="news-article-title">{title}</h1>
        <p class="news-article-summary">{summary}</p>
        {
          tags.length > 0 && (
            <div class="news-tags">
              {tags.map((tag) => (
                <span class="news-tag">{tag}</span>
              ))}
            </div>
          )
        }
      </header>

      <figure class="news-article-figure">
        <img
          src={coverImg.src}
          srcset={coverImg.srcSet.attribute}
          sizes="(max-width: 768px) 100vw, 760px"
          alt={title}
          width={coverImg.width}
          height={coverImg.height}
          class="news-article-cover"
        />
      </figure>

      <div class="news-body">
        <Content />
      </div>

      <footer class="news-article-footer">
        <span>&mdash; {author}, Iron Biker's Club Cartagena</span>
        <a class="news-back" href="/noticias">&larr; Más noticias</a>
      </footer>
    </article>
  </main>
</BaseLayout>
