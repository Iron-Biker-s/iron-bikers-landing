---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection, getEntry, render } from "astro:content";
import "../styles/rules.css";

const { data: meta } = (await getEntry("reglamento", "reglamento"))!;
const chapters = (await getCollection("rules")).sort(
  (a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title),
);

const rendered = await Promise.all(
  chapters.map(async (chapter) => ({
    chapter,
    Content: (await render(chapter)).Content,
  })),
);
---

<BaseLayout
  title="Reglamento — Iron Biker's"
  description="Reglamento interno de Iron Biker's Club Cartagena: ingreso, deberes y derechos de los oficiales, normas de rodada y convivencia."
>
  <main class="rules-page" id="contenido" tabindex="-1">
    <section class="rules-hero">
      <div class="rules-hero-inner">
        <span class="rules-kicker">&middot; Las normas del club</span>
        <h1 class="rules-title">
          {meta.title}
          <span>{meta.titleSpan}</span>
        </h1>
        <p class="rules-subtitle">{meta.subtitle}</p>
        <a class="btn rules-pdf" href={meta.pdfUrl} download>
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            ><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><path
              d="m7 10 5 5 5-5"></path><path d="M12 15V3"></path></svg
          >
          Descargar PDF
        </a>
      </div>
    </section>

    <section class="rules-id" aria-label="Identificación motera">
      <blockquote class="rules-id-lema">&ldquo;{meta.lema}&rdquo;</blockquote>
      <div class="rules-id-grid">
        <div class="rules-id-item">
          <span class="rules-id-label">Punto de encuentro</span>
          <strong>{meta.puntoEncuentro}</strong>
        </div>
        <div class="rules-id-item">
          <span class="rules-id-label">Día de zona</span>
          <strong>{meta.diaZona}</strong>
        </div>
        <div class="rules-id-item">
          <span class="rules-id-label">Saludo motero</span>
          <strong>&#9996;&#65039; Dos dedos a la vía</strong>
        </div>
      </div>
    </section>

    <div class="rules-layout">
      <aside class="rules-toc" aria-label="Índice del reglamento">
        <nav class="rules-toc-nav" id="rulesToc">
          <span class="rules-toc-title">Índice</span>
          {
            chapters.map((chapter, i) => (
              <a href={`#${chapter.id}`} class="rules-toc-link">
                <span class="rules-toc-num">
                  {String(i + 1).padStart(2, "0")}
                </span>
                {chapter.data.title}
              </a>
            ))
          }
        </nav>
      </aside>

      <div class="rules-body">
        {
          rendered.map(({ chapter, Content }, i) => (
            <section class="rule-chapter" id={chapter.id}>
              <header class="rule-chapter-head">
                <span class="rule-chapter-num">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <h2 class="rule-chapter-title">{chapter.data.title}</h2>
              </header>
              {chapter.data.intro && (
                <p class="rule-chapter-intro">{chapter.data.intro}</p>
              )}
              <div class="rule-content">
                <Content />
              </div>
            </section>
          ))
        }
        <p class="rules-foot">
          ¿Dudas sobre el reglamento? <a href="/#contacto">Habla con la
          directiva</a> o descarga la
          <a href={meta.pdfUrl} download>versión oficial en PDF</a>.
        </p>
      </div>
    </div>
  </main>

  <script>
    /* Scroll-spy del índice del reglamento */
    const tocLinks = document.querySelectorAll(".rules-toc-link");
    const chapters = document.querySelectorAll(".rule-chapter");
    if (tocLinks.length && chapters.length) {
      const setActive = (id: string) => {
        tocLinks.forEach((l) =>
          l.classList.toggle("is-active", l.getAttribute("href") === `#${id}`),
        );
      };
      const spy = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) setActive(e.target.id);
          });
        },
        { rootMargin: "-30% 0px -60% 0px" },
      );
      chapters.forEach((c) => spy.observe(c));
    }
  </script>
</BaseLayout>
