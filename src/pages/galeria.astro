---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection, getEntry } from "astro:content";
import { getCover } from "../lib/image";
import "../styles/gallery.css";

const { data: sections } = (await getEntry("sections", "sections"))!;
const galleryItems = (await getCollection("gallery")).sort(
  (a, b) =>
    (a.data.order ?? Number.MAX_SAFE_INTEGER) -
      (b.data.order ?? Number.MAX_SAFE_INTEGER) ||
    a.data.title.localeCompare(b.data.title),
);
const images = await Promise.all(
  galleryItems.map((item) => getCover(item.data.image, [480, 960])),
);
---

<BaseLayout
  title="Galería — Iron Biker's"
  description="Cada rodada, cada recuerdo. Fotos y momentos del club."
>
  <main class="gallery-page" id="contenido" tabindex="-1">
    <section class="gallery-hero">
      <div class="gallery-hero-inner">
        <span class="gallery-kicker">&middot; Archivo visual del club</span>
        <h1 class="gallery-title">
          {sections.galleryTitle}
          <span>{sections.galleryTitleSpan}</span>
        </h1>
        <p class="gallery-subtitle">{sections.gallerySubtitle}</p>
      </div>
    </section>

    <section class="gallery-masonry">
      {
        galleryItems.map(({ data: item }, index) => (
          <button
            class="gallery-item"
            data-gallery-item
            data-title={item.title}
            data-category={item.category}
            data-full={item.image}
            type="button"
            aria-label={`Ver ${item.title} en grande`}
          >
            <img
              src={images[index].src}
              srcset={images[index].srcSet.attribute}
              sizes="(max-width: 640px) 100vw, (max-width: 900px) 50vw, 33vw"
              alt={item.alt}
              width={images[index].width}
              height={images[index].height}
              loading="lazy"
              decoding="async"
            />
            <span class="gallery-item-overlay">
              <span class="gallery-item-title">{item.title}</span>
              <span class="gallery-item-category">{item.category}</span>
            </span>
          </button>
        ))
      }
    </section>
  </main>
</BaseLayout>
