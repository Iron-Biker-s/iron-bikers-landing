---
import { getEntry } from "astro:content";
import { getCover } from "../lib/image";

const { data: hero } = (await getEntry("hero", "hero"))!;
const heroLogo = await getCover(hero.logo, [320]);

/* La página madre puede pasar `bg` ya optimizado (reusa el preload) */
interface Props {
  bg?: Awaited<ReturnType<typeof getCover>>;
}
const { bg } = Astro.props;
const heroBg = bg ?? (await getCover(hero.bgImage, [768, 1280, 1920, 2560]));
---

<header class="hero">
  <div
    class="hero-bg parallax-bg"
    id="heroParallax"
    role="img"
    aria-label="Fondo del hero: miembros del club en ruta"
  >
    <img
      src={heroBg.src}
      srcset={heroBg.srcSet.attribute}
      sizes="100vw"
      alt=""
      width={heroBg.width}
      height={heroBg.height}
      fetchpriority="high"
      decoding="async"
      class="hero-bg-img"
    />
    <div class="hero-bg-overlay"></div>
  </div>
  <div class="hero-content">
    <div class="hero-logo">
      <img
        src={heroLogo.src}
        srcset={heroLogo.srcSet.attribute}
        sizes="160px"
        alt={hero.logoAlt}
        width="160"
        height="160"
      />
    </div>
    {hero.badge && <span class="hero-badge">{hero.badge}</span>}
    <h1 class="hero-title">
      {hero.title}<br />
      <span>{hero.titleSpan}</span>
    </h1>
    <p class="hero-quote">&ldquo;{hero.quote}&rdquo;</p>
    <div class="hero-cta">
      <a class="btn" href="/unete">Únete al club</a>
      <a class="btn btn-outline-gold" href="/nosotros">Conócenos</a>
    </div>
    <div class="hero-stats">
      {
        hero.stats.map((stat) => (
          <div class="hero-stat">
            <span class="hero-stat-value">{stat.value}</span>
            <span class="hero-stat-label">{stat.label}</span>
          </div>
        ))
      }
    </div>
  </div>
</header>
