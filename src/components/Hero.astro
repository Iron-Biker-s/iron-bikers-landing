---
import { getEntry } from "astro:content";
import logoImg from "../assets/images/logo.webp";

const { data: hero } = (await getEntry("hero", "hero"))!;
---

<header class="hero">
  <div
    class="hero-bg parallax-bg"
    id="heroParallax"
    style={`background-image: url('/images/hero-bg.webp');`}
    role="img"
    aria-label="Fondo del hero: miembros del club en ruta"
  >
    <div class="hero-bg-overlay"></div>
  </div>
  <div class="hero-content">
    <div class="hero-logo">
      <img src={logoImg.src} alt="Iron Biker's Club Logo" width="160" height="160" />
    </div>
    {hero.badge && <span class="hero-badge">{hero.badge}</span>}
    <h1 class="hero-title">
      {hero.title}<br />
      <span>{hero.titleSpan}</span>
    </h1>
    <p class="hero-quote">&ldquo;{hero.quote}&rdquo;</p>
    <div class="hero-stats">
      {
        hero.stats.map((stat) => (
          <div class="hero-stat">
            <span class="hero-stat-value">{stat.value}</span>
            <span class="hero-stat-label">{stat.label}</span>
          </div>
        ))
      }
    </div>
  </div>
</header>
