---
import { getEntry } from "astro:content";

const { data: contact } = (await getEntry("contact", "contact"))!;
const { data: siteInfo } = (await getEntry("site", "site"))!;
---

<section class="contact" id="contacto">
  <div class="contact-bg" aria-hidden="true">
    <img
      src="/images/hero-bg.webp"
      alt=""
      loading="lazy"
      decoding="async"
      class="contact-bg-img"
    />
    <div class="contact-bg-overlay"></div>
  </div>
  <div class="contact-inner">
    <div class="contact-panel reveal">
      <h2 class="contact-title">
        {contact.titleLine1}<br />
        {contact.titleLine2}
      </h2>
      <p class="contact-text">{contact.text}</p>
      <div class="contact-actions">
        <a class="contact-cta" href="/unete">{contact.ctaLabel}</a>
        <a class="contact-email" href={`mailto:${siteInfo.email}`}>
          {siteInfo.email}
        </a>
      </div>
    </div>
  </div>
</section>
