---
import { getEntry } from "astro:content";
import { getCover } from "../lib/image";

const { data: jersey } = (await getEntry("jersey", "jersey"))!;
const jerseyImg = await getCover(jersey.image, [480, 640]);
---

<section class="jersey" id="jersey">
  <div class="jersey-grid">
    <div class="jersey-visual reveal">
      <div class="jersey-glow" aria-hidden="true"></div>
      <div class="jersey-panel">
        <img
          src={jerseyImg.src}
          srcset={jerseyImg.srcSet.attribute}
          sizes="320px"
          alt={jersey.imageAlt}
          class="jersey-logo"
          loading="lazy"
          decoding="async"
        />
        <div class="jersey-badge">
          <span>Edición Limitada</span>
        </div>
      </div>
    </div>
    <div class="jersey-info reveal reveal-delay-1">
      <h2 class="jersey-title">
        {jersey.titleLine1}<br />
        {jersey.titleLine2}
      </h2>
      <p class="jersey-text">{jersey.text}</p>
      <a href="#contacto" class="btn btn-outline-gold">{jersey.button}</a>
    </div>
  </div>
</section>
