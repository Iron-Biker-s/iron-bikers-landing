---
import { getCollection } from "astro:content";
import { getCover } from "../lib/image";

const pilots = (await getCollection("pilots")).sort((a, b) =>
  a.data.name.localeCompare(b.data.name)
);

const images = await Promise.all(pilots.map((pilot) => getCover(pilot.data.image, [192, 384])));
---

<section class="leaders" id="directivos">
  <div class="leaders-header reveal">
    <h2 class="leaders-title">Liderazgo &amp; Visión</h2>
    <p class="leaders-subtitle">
      Los arquitectos detrás de la ruta. Hombres de asfalto y visión empresarial.
    </p>
  </div>
  <div class="leaders-list">
    {
      pilots.map(({ data: pilot }, index) => (
        <div
          class:list={["leader-card", "reveal", `reveal-delay-${(index % 3) + 1}`]}
        >
          <div class="leader-avatar">
            <div class="leader-avatar-inner">
              <div class="leader-avatar-photo">
                <img
                  src={images[index].src}
                  srcset={images[index].srcSet.attribute}
                  sizes="192px"
                  alt={pilot.alt}
                  loading="lazy"
                  decoding="async"
                  class="leader-photo"
                />
              </div>
            </div>
          </div>
          <h3 class="leader-name">{pilot.name}</h3>
          <span class="leader-role">{pilot.role}</span>
        </div>
      ))
    }
  </div>
</section>
