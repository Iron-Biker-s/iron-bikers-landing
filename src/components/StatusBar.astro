---
import { getEntry } from "astro:content";

interface StatusItem {
  text: string;
  highlight?: boolean;
  dot?: boolean;
  sep?: string;
  duplicate?: boolean;
}

const { data: statusbar } = (await getEntry("statusbar", "statusbar"))!;

const baseItems: StatusItem[] = [
  { text: statusbar.rodada, dot: true },
  { text: "—", sep: "—" },
  { text: statusbar.destino },
  { text: "—", sep: "—" },
  { text: statusbar.cupos, highlight: true },
  { text: "/", sep: "/" },
];

const marqueeItems: StatusItem[] = [false, true].flatMap((duplicate) =>
  baseItems.map((item) => ({ ...item, duplicate }))
);
---

<div class="statusbar">
  <div class="statusbar-mobile">
    <span class="statusbar-item">
      <span class="statusbar-dot"></span>
      {statusbar.rodada}
    </span>
    <span class="statusbar-item">
      {statusbar.destino} <span class="statusbar-sep">&mdash;</span>
      <span class="statusbar-highlight">{statusbar.cupos}</span>
    </span>
  </div>
  <div class="statusbar-marquee">
    <div class="statusbar-track">
      {
        marqueeItems.map((item) =>
          item.sep ? (
            <span class="statusbar-sep" aria-hidden={item.duplicate || undefined}>{item.sep}</span>
          ) : (
            <span
              class:list={["statusbar-item", item.highlight && "statusbar-highlight"]}
              aria-hidden={item.duplicate || undefined}
            >
              {item.dot && <span class="statusbar-dot" aria-hidden="true"></span>}
              {item.text}
            </span>
          )
        )
      }
    </div>
  </div>
</div>
