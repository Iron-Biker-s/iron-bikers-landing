---
import { getEntry } from "astro:content";

interface StatusItem {
  text: string;
  highlight?: boolean;
  dot?: boolean;
  sep?: string;
  hidden?: boolean;
}

const { data: statusbar } = (await getEntry("statusbar", "statusbar"))!;

const baseItems: StatusItem[] = [
  { text: statusbar.rodada, dot: true },
  { text: "—", sep: "—" },
  { text: statusbar.destino },
  ...(statusbar.cupos
    ? ([
        { text: "—", sep: "—" },
        { text: statusbar.cupos, highlight: true },
      ] satisfies StatusItem[])
    : []),
  { text: "/", sep: "/" },
];

/* La pista debe ser >= 2× el viewport para que el loop translateX(-50%)
   no deje huecos: repetimos la unidad varias veces por mitad. Solo la
   primera unidad es visible para lectores de pantalla; el resto va
   aria-hidden. */
const REPEAT = 6;
const marqueeItems: StatusItem[] = Array.from(
  { length: REPEAT * 2 },
  (_, repeatIndex) =>
    baseItems.map((item) => ({ ...item, hidden: repeatIndex > 0 })),
).flat();
---

<div class="statusbar">
  <div class="statusbar-mobile">
    <span class="statusbar-item">
      <span class="statusbar-dot"></span>
      {statusbar.rodada}
    </span>
    <span class="statusbar-item">
      {statusbar.destino}
      {
        statusbar.cupos && (
          <>
            <span class="statusbar-sep">&mdash;</span>
            <span class="statusbar-highlight">{statusbar.cupos}</span>
          </>
        )
      }
    </span>
  </div>
  <div class="statusbar-marquee">
    <div class="statusbar-track">
      {
        marqueeItems.map((item) =>
          item.sep ? (
            <span class="statusbar-sep" aria-hidden={item.hidden || undefined}>
              {item.sep}
            </span>
          ) : (
            <span
              class:list={[
                "statusbar-item",
                item.highlight && "statusbar-highlight",
              ]}
              aria-hidden={item.hidden || undefined}
            >
              {item.dot && <span class="statusbar-dot" aria-hidden="true" />}
              {item.text}
            </span>
          ),
        )
      }
    </div>
  </div>
</div>
