---
import { getCollection, getEntry } from "astro:content";
import { getCover } from "../lib/image";
import "../styles/gallery.css";

const MAX_IN_HOME = 6;
const { data: sections } = (await getEntry("sections", "sections"))!;
const todas = (await getCollection("gallery")).sort(
  (a, b) =>
    (a.data.order ?? Number.MAX_SAFE_INTEGER) -
      (b.data.order ?? Number.MAX_SAFE_INTEGER) ||
    a.data.title.localeCompare(b.data.title),
);
const items = todas.slice(0, MAX_IN_HOME);
const hayMas = todas.length > MAX_IN_HOME;

const images = await Promise.all(
  items.map((item) => getCover(item.data.image, [480, 960])),
);
---

<section class="gallery-preview" id="galeria" aria-label="Galería del club">
  <div class="gallery-preview-inner">
    <div class="gallery-preview-header reveal">
      <span class="gallery-kicker">&middot; Archivo visual</span>
      <h2 class="gallery-preview-title">
        {sections.galleryTitle}
        <span>{sections.galleryTitleSpan}</span>
      </h2>
      <p class="gallery-preview-subtitle">{sections.gallerySubtitle}</p>
    </div>

    <div class="gallery-preview-grid">
      {
        items.map(({ data: item }, index) => (
          <a
            class:list={[
              "gallery-item",
              "reveal",
              `reveal-delay-${(index % 3) + 1}`,
            ]}
            href="/galeria"
            aria-label={`Ver ${item.title} en la galería`}
          >
            <img
              src={images[index].src}
              srcset={images[index].srcSet.attribute}
              sizes="(max-width: 640px) 100vw, (max-width: 900px) 50vw, 33vw"
              alt={item.alt}
              width={images[index].width}
              height={images[index].height}
              loading="lazy"
              decoding="async"
            />
            <span class="gallery-item-overlay">
              <span class="gallery-item-title">{item.title}</span>
              <span class="gallery-item-category">{item.category}</span>
            </span>
          </a>
        ))
      }
    </div>

    {
      hayMas && (
        <div class="gallery-preview-cta reveal">
          <a class="btn btn-outline-gold" href="/galeria">
            Ver galería completa
          </a>
        </div>
      )
    }
  </div>
</section>
