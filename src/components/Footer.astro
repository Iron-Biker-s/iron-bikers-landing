---
import { site } from "../data/site";
import logoImg from "../assets/images/logo.webp";
---

<footer class="footer">
  <div class="footer-wave" aria-hidden="true">
    <svg viewBox="0 0 1200 120" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M1200 120L0 16.48 0 0 1200 0 1200 120z"></path>
    </svg>
  </div>
  <div class="footer-inner">
    <div class="footer-logo">
      <img src={logoImg.src} alt="Logo de Iron Biker's" class="footer-logo-img" width="160" height="160" loading="lazy" decoding="async" />
      <img src={logoImg.src} alt="" class="footer-logo-reflect" width="160" height="160" loading="lazy" decoding="async" />
    </div>
    <nav class="footer-links" aria-label="Enlaces legales">
      <a href={site.privacyUrl} target="_blank" rel="noopener">Política de privacidad</a>
      <a href={site.deleteAccountUrl} target="_blank" rel="noopener">Eliminar cuenta</a>
      <a href="#contacto">Soporte</a>
    </nav>
    <div class="footer-contact">
      <p>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg>
        {site.city}
      </p>
      <p>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </p>
      <p>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        Club de Motociclismo de Cartagena
      </p>
    </div>
    <p class="footer-copyright">&copy; 2026 {site.siteName.toUpperCase()}. BEYOND LIMITS.</p>
    <p class="footer-nit">{site.nit}</p>
  </div>
</footer>
