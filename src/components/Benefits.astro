---
import { getEntry } from "astro:content";

const { data: benefits } = (await getEntry("benefits", "benefits"))!;
---

<section class="benefits" id="beneficios">
  <div class="benefits-grid">
    <div class="benefits-side reveal">
      <h2 class="benefits-title">
        {benefits.titleLine1}<br />
        {benefits.titleLine2}
      </h2>
      <div class="benefits-frame">
        <img
          src="/images/hero-bg.webp"
          alt="Experiencia premium del club"
          loading="lazy"
          decoding="async"
          class="benefits-frame-img"
        />
      </div>
    </div>
    <div class="benefits-timeline">
      {
        benefits.items.map((benefit, index) => (
          <div
            class:list={[
              "benefit-item",
              benefit.featured && "benefit-item-featured",
              "reveal",
              `reveal-delay-${(index % 3) + 1}`,
            ]}
          >
            <span class="benefit-dot" aria-hidden="true"></span>
            <h3 class="benefit-title">{benefit.title}</h3>
            <p class="benefit-text">{benefit.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
