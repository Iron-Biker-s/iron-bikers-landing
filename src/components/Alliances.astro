---
import { getCollection } from "astro:content";
import { getCover } from "../lib/image";

const alliances = await getCollection("alliances");
const logos = await Promise.all(
  alliances.map((a) => getCover(a.data.logo, [320]))
);
---

<section class="alliances" id="alianzas">
  <div class="alliances-inner">
    <div class="alliances-header reveal">
      <h2 class="alliances-title">Aliados Estratégicos</h2>
      <p class="alliances-subtitle">
        Marcas y empresas que comparten nuestra pasión por el motociclismo de alto nivel.
      </p>
    </div>
    <div class="alliances-grid">
      {
        alliances.map(({ data: alliance }, index) => (
          <div
            class:list={["alliance-card", "reveal", `reveal-delay-${(index % 3) + 1}`]}
          >
            <div class="alliance-logo">
              <img
                src={logos[index].src}
                srcset={logos[index].srcSet.attribute}
                sizes="160px"
                alt={alliance.alt}
                loading="lazy"
                decoding="async"
                class="alliance-logo-img"
              />
            </div>
            <div class="alliance-info">
              <h3 class="alliance-name">{alliance.name}</h3>
              <span class="alliance-category">{alliance.category}</span>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
