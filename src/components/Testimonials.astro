---
import { getCollection, getEntry } from "astro:content";
import { getCover } from "../lib/image";

const { data: sections } = (await getEntry("sections", "sections"))!;
const testimonials = (await getCollection("testimonials")).sort(
  (a, b) =>
    (a.data.order ?? Number.MAX_SAFE_INTEGER) -
    (b.data.order ?? Number.MAX_SAFE_INTEGER),
);
const images = await Promise.all(
  testimonials.map((t) => getCover(t.data.image, [96])),
);
---

<section class="testimonials" id="testimonios">
  <div class="testimonials-inner">
    <h2 class="testimonials-title reveal">{sections.testimonialsTitle}</h2>
    <div class="testimonials-grid">
      {
        testimonials.map(({ data: testimonial }, index) => (
          <article
            class:list={[
              "testimonial-card",
              "reveal",
              `reveal-delay-${(index % 3) + 1}`,
            ]}
          >
            <div class="testimonial-mark" aria-hidden="true">
              &ldquo;
            </div>
            <p class="testimonial-quote">{testimonial.quote}</p>
            <div class="testimonial-author">
              <div class="testimonial-avatar">
                <img
                  src={images[index].src}
                  srcset={images[index].srcSet.attribute}
                  sizes="48px"
                  alt={testimonial.alt}
                  width={images[index].width}
                  height={images[index].height}
                  loading="lazy"
                  decoding="async"
                  class="testimonial-photo"
                />
              </div>
              <div>
                <h3 class="testimonial-name">{testimonial.name}</h3>
                <span class="testimonial-role">{testimonial.role}</span>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
