---
import { getCollection, getEntry } from "astro:content";
import { getCover } from "../lib/image";

const { data: sections } = (await getEntry("sections", "sections"))!;

const events = await getCollection("events");
const images = await Promise.all(
  events.map((e) => getCover(e.data.image, [480, 720])),
);
---

<section class="events" id="eventos">
  <div class="events-inner">
    <h2 class="events-title reveal">{sections.eventsTitle}</h2>
    <p class="events-subtitle reveal reveal-delay-1">
      {sections.eventsSubtitle}
    </p>

    <div class="event-carousel-wrap reveal reveal-delay-2">
      <button
        class="event-arrow event-prev"
        aria-label="Desplazar a la izquierda"
      >
        ‹
      </button>
      <div class="event-carousel">
        {
          events.map(({ data: event }, index) => (
            <article
              class:list={[
                "event-poster",
                "reveal",
                `reveal-delay-${(index % 3) + 1}`,
              ]}
            >
              <img
                src={images[index].src}
                srcset={images[index].srcSet.attribute}
                sizes="(max-width: 640px) 70vw, 300px"
                alt={event.alt}
                width={images[index].width}
                height={images[index].height}
                loading="lazy"
                decoding="async"
                class="event-image"
              />
              <span class="event-chip">{event.categoria}</span>
              <div class="event-overlay">
                <h4 class="event-name">{event.title}</h4>
                <p class="event-tag">{event.tag}</p>
              </div>
            </article>
          ))
        }
      </div>
      <button
        class="event-arrow event-next"
        aria-label="Desplazar a la derecha"
      >
        ›
      </button>
    </div>
  </div>
</section>
