---
import logoImg from "../assets/images/logo.webp";
---

<div class="splash" id="splash" role="status" aria-label="Cargando">
  <div class="splash-mark">
    <img src={logoImg.src} alt="" width="88" height="88" />
  </div>

  <div class="splash-stage">
    <div class="splash-road" aria-hidden="true"></div>
    <div class="splash-bike" aria-hidden="true">
      <div class="splash-bike-inner">
        <img src="/images/moto_pixelada_loader.png" alt="" width="170" height="113" />
      </div>
      <div class="splash-puffs" aria-hidden="true">
        <span class="splash-puff"></span>
        <span class="splash-puff"></span>
        <span class="splash-puff"></span>
      </div>
    </div>
  </div>

  <div class="splash-rev" aria-hidden="true"></div>
  <div class="splash-tag">Preparando la ruta&hellip;</div>
</div>
